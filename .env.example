# Лише назви змінних; значення — у ~/.config/claude-secrets/rover.env або локальному .env (поза git).
# ingest (роль Postgres ingest; обліковий запис брокера rover-ingest)
INGEST_DATABASE_URL=
MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
# web (роль Postgres viewer)
WEB_DATABASE_URL=
# лише для ops/ (скрипти Оператора); живуть у ~/.config/claude-secrets/rover.env, не в .env сервісів
ROVER_OWNER_PASSWORD=
ROVER_INGEST_PASSWORD=
ROVER_VIEWER_PASSWORD=
ROVER_OWNER_DATABASE_URL=
